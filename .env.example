# Cloud configuration (Next.js route handlers).
# Copy to `.env.local` for local `next dev`. On Vercel set these in the project's
# Environment Variables. NEVER commit real values — `.env*` is gitignored.
#
# Architecture: object storage = Cloudflare R2; auth + realtime = Firebase.

# ── Cloudflare R2 (object storage: project JSON, snapshots, audio blobs) ─────────
# Private bucket reached via the S3 API. Browsers never see these — audio moves via
# short-lived presigned URLs; project/meta JSON is read/written server-side.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional endpoint override (default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
# R2_ENDPOINT=
# Origins allowed to PUT/GET audio via presigned URLs (used by scripts/set-r2-cors.mjs).
# R2_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Firebase web (client) config — AUTH ONLY ────────────────────────────────────
# Public values from the Firebase console (Project settings → your web app). Inlined into
# the client bundle at build time (NEXT_PUBLIC_*), so they are not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL (e.g. https://<project>-default-rtdb.firebaseio.com). Required for
# live collaboration + cursors; if unset the app still runs and live editing stays disabled.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ── Firebase Admin (server: verify ID tokens, mint realtime custom tokens) ──────
# Paste the service-account key JSON (single line) here. On Vercel this is the way in
# (no Application Default Credentials); locally you may instead use
# GOOGLE_APPLICATION_CREDENTIALS or `gcloud auth application-default login`.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Optional ────────────────────────────────────────────────────────────────────
# Client override for the API base URL (default: same origin). Leave unset normally.
# NEXT_PUBLIC_API_BASE=

# Canonical public site URL (e.g. https://cue-timeline.example.com). Used as the metadataBase
# so link-preview (Open Graph / Twitter) image URLs resolve to absolute URLs. Locally it
# defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Set to `off` to force-disable realtime in the client build (no connection attempts at all).
# Leave unset to use the Realtime Database whenever NEXT_PUBLIC_FIREBASE_DATABASE_URL is set.
# NEXT_PUBLIC_REALTIME=
