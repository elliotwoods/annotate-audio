# Cloud persistence configuration (Next.js route handlers + Cloudflare R2).
# Copy to `.env.local` for local `next dev`, and set the same vars in the Vercel project.
# NEVER commit the real values — `.env*` is gitignored.

# Verified-user access key (the "admin" secret). Anyone with this can create cloud
# projects. Generate ~10 url-safe chars, e.g. `openssl rand -base64 8 | tr -dc 'A-Za-z0-9' | head -c 10`.
ADMIN_KEY=

# Cloudflare R2 (S3-compatible) credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the endpoint. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Optional client override for the API base URL (default: same origin). Leave unset for
# normal Vercel deploys where the app and /api route handlers share an origin.
# NEXT_PUBLIC_API_BASE=

# ── Realtime collaboration (Ably) ──────────────────────────────────────────────
# Server-side Ably API key, used ONLY by /api/realtime/token to mint short-lived,
# capability-scoped tokens for the browser. The key itself never reaches the client.
# Get one from https://ably.com (free tier is ample for a small team). If unset, the app
# still works — live collaboration just stays disabled (the token endpoint returns 501).
ABLY_API_KEY=

# Optional: set to `off` to force-disable realtime in the client build (no connection
# attempts at all). Leave unset to use Ably whenever ABLY_API_KEY is configured server-side.
# NEXT_PUBLIC_REALTIME=
