# Cloud configuration (Next.js route handlers + Firebase).
# Copy to `.env.local` for local `next dev`. On Firebase App Hosting set these via
# apphosting.yaml (and Cloud Secret Manager for any you treat as secret).
# NEVER commit real values — `.env*` is gitignored.

# ── Firebase web (client) config ───────────────────────────────────────────────
# Public values from the Firebase console (Project settings → your web app). They are
# inlined into the client bundle at build time (NEXT_PUBLIC_*), so they are not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL (e.g. https://<project>-default-rtdb.firebaseio.com). Required for live
# collaboration; if unset the app still runs and live editing simply stays disabled.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ── Server (Admin SDK) config ───────────────────────────────────────────────────
# Bucket for project JSON + audio blobs (usually <project>.appspot.com or
# <project>.firebasestorage.app). Defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET if unset.
STORAGE_BUCKET=

# Admin credentials: on Firebase App Hosting / Cloud Run these come from the runtime service
# account automatically (Application Default Credentials) — leave the below unset there.
# For LOCAL dev, authenticate one of these ways:
#   • run `gcloud auth application-default login`, or
#   • set GOOGLE_APPLICATION_CREDENTIALS to a service-account key file, or
#   • paste the service-account key JSON (single line) into FIREBASE_SERVICE_ACCOUNT.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT=

# Origins allowed to PUT/GET audio via signed URLs (used by scripts/set-gcs-cors.mjs).
# GCS_CORS_ORIGINS=http://localhost:3000,https://your-app.web.app

# ── Optional ────────────────────────────────────────────────────────────────────
# Client override for the API base URL (default: same origin). Leave unset normally.
# NEXT_PUBLIC_API_BASE=

# Canonical public site URL (e.g. https://cue-timeline.example.com). Used as the metadataBase
# so link-preview (Open Graph / Twitter) image URLs resolve to absolute URLs. Locally it
# defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Set to `off` to force-disable realtime in the client build (no connection attempts at all).
# Leave unset to use the Realtime Database whenever NEXT_PUBLIC_FIREBASE_DATABASE_URL is set.
# NEXT_PUBLIC_REALTIME=
